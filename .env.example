# 复制为 .env 并填写。所有密钥不进 git（.gitignore 已排除）。

# --- 必填 ---
# 本地开发直连；docker compose 里会被覆盖为容器内地址
DATABASE_URL=postgresql://bsam:bsam@127.0.0.1:5432/bsam
REDIS_URL=redis://127.0.0.1:6379
# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32（LLM API Key 加密主密钥，丢失则已存密钥全部作废）
MASTER_KEY=
# openssl rand -hex 32（微信 Bot → 平台 的 HMAC 签名密钥）
INGEST_HMAC_SECRET=
# docker compose 用的数据库密码
POSTGRES_PASSWORD=

# --- 可选 ---
# GitHub fine-grained PAT：仅授权被管理仓库 contents 读写（M3 起需要）
GITHUB_BOT_PAT=
# 以 path 前缀部署时设为 /pm（ADR-001）
APP_BASE_PATH=
# 需求线索聚合窗口（分钟）
AGG_WINDOW_MINUTES=30
# 认领心跳超时（小时）
CLAIM_TIMEOUT_HOURS=4
LOG_LEVEL=info
